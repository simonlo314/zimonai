{
  "name": "zimonai-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "dev:pages": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply zimonai-analytics --local",
    "serve": "node scripts/serve.mjs",
    "analytics:weekly": "node scripts/weekly-analytics.mjs"
  },
  "dependencies": {
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
